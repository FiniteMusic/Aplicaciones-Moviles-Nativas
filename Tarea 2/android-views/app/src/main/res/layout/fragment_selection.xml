<?xml version="1.0" encoding="utf-8"?>

<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"

    android:layout_width="match_parent"
    android:layout_height="match_parent"

    android:background="@color/garage_background"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"

        android:orientation="vertical"
        android:padding="20dp">


        <!-- ================================= -->
        <!-- ENCABEZADO MERCEDES               -->
        <!-- ================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginBottom="28dp"

            app:cardBackgroundColor="@color/garage_header"
            app:cardCornerRadius="20dp"
            app:cardElevation="0dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:text="MERCEDES · SECCIÓN 03"
                        android:textColor="#7CE9DD"

                        android:textSize="12sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="10dp"

                        android:text="Configuración de carrera"

                        android:textColor="@color/f1_white"
                        android:textSize="26sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"

                        android:layout_marginTop="8dp"

                        android:text="Explora los componentes de selección mediante los ajustes de un monoplaza de Fórmula 1."

                        android:textColor="#D5D8DF"
                        android:textSize="14sp" />

                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="5dp"

                    android:background="@color/team_mercedes" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================= -->
        <!-- 01 - CHECKBOX                     -->
        <!-- ================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="1. CheckBox"

            android:textColor="@color/garage_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"

            android:text="Permite seleccionar varias opciones independientes. Cada casilla puede activarse o desactivarse sin afectar a las demás."

            android:textColor="@color/garage_text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkTires"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Revisar neumáticos"
            android:textColor="@color/garage_text_primary"

            app:buttonTint="@color/accent_mercedes" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkFuel"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Verificar combustible"
            android:textColor="@color/garage_text_primary"

            app:buttonTint="@color/accent_mercedes" />

        <com.google.android.material.checkbox.MaterialCheckBox
            android:id="@+id/checkAerodynamics"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Inspeccionar aerodinámica"
            android:textColor="@color/garage_text_primary"

            app:buttonTint="@color/accent_mercedes" />


        <!-- ================================= -->
        <!-- 02 - RADIOGROUP / RADIOBUTTON     -->
        <!-- ================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="28dp"

            android:text="2. RadioGroup y RadioButton"

            android:textColor="@color/garage_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"

            android:text="Permite elegir una sola opción dentro de un conjunto. Al seleccionar una alternativa, la anterior se desmarca automáticamente."

            android:textColor="@color/garage_text_secondary"
            android:textSize="14sp" />

        <RadioGroup
            android:id="@+id/radioGroupTires"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:orientation="vertical">

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioSoft"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Blando · Soft"
                android:textColor="@color/garage_text_primary"

                app:buttonTint="@color/accent_mercedes" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioMedium"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Medio · Medium"
                android:textColor="@color/garage_text_primary"

                app:buttonTint="@color/accent_mercedes" />

            <com.google.android.material.radiobutton.MaterialRadioButton
                android:id="@+id/radioHard"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:text="Duro · Hard"
                android:textColor="@color/garage_text_primary"

                app:buttonTint="@color/accent_mercedes" />

        </RadioGroup>


        <!-- ================================= -->
        <!-- 03 - SPINNER                      -->
        <!-- ================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="28dp"

            android:text="3. Spinner"

            android:textColor="@color/garage_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"

            android:text="Presenta una lista desplegable de opciones. Ocupa poco espacio y permite seleccionar un valor entre varios disponibles."

            android:textColor="@color/garage_text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            app:cardBackgroundColor="@color/garage_surface"
            app:cardCornerRadius="12dp"

            app:strokeColor="@color/garage_border"
            app:strokeWidth="1dp">

            <Spinner
                android:id="@+id/spinnerCircuit"

                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:minHeight="56dp"
                android:paddingStart="12dp"
                android:paddingEnd="12dp" />

        </com.google.android.material.card.MaterialCardView>


        <!-- ================================= -->
        <!-- 04 - SWITCH                       -->
        <!-- ================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="28dp"

            android:text="4. SwitchMaterial"

            android:textColor="@color/garage_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"

            android:text="Activa o desactiva una configuración binaria. Su estado permanece visible mientras el usuario interactúa con otros controles."

            android:textColor="@color/garage_text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.switchmaterial.SwitchMaterial
            android:id="@+id/switchEnergySaving"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Modo de ahorro de energía"

            android:textColor="@color/garage_text_primary" />


        <!-- ================================= -->
        <!-- 05 - SEEKBAR                      -->
        <!-- ================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="28dp"

            android:text="5. SeekBar"

            android:textColor="@color/garage_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"

            android:text="Permite ajustar un valor dentro de un intervalo mediante el desplazamiento de un control deslizante."

            android:textColor="@color/garage_text_secondary"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/textBrakeBalance"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:text="Balance de frenado: 55 %"

            android:textColor="@color/garage_text_primary"
            android:textSize="15sp"
            android:textStyle="bold" />

        <SeekBar
            android:id="@+id/seekBrakeBalance"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:max="70"
            android:progress="55"

            android:progressTint="@color/accent_mercedes"
            android:thumbTint="@color/accent_mercedes" />


        <!-- ================================= -->
        <!-- 06 - RATINGBAR                    -->
        <!-- ================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="28dp"

            android:text="6. RatingBar"

            android:textColor="@color/garage_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"

            android:text="Permite expresar una valoración mediante estrellas. Puede utilizarse para recopilar opiniones sobre una experiencia o configuración."

            android:textColor="@color/garage_text_secondary"
            android:textSize="14sp" />

        <RatingBar
            android:id="@+id/ratingSetup"

            android:layout_width="wrap_content"
            android:layout_height="wrap_content"

            android:numStars="5"
            android:rating="3"
            android:stepSize="0.5"

            android:progressTint="@color/accent_mercedes"
            android:secondaryProgressTint="@color/team_mercedes" />

        <TextView
            android:id="@+id/textSetupRating"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="8dp"

            android:text="Valoración: 3 de 5 estrellas"

            android:textColor="@color/garage_text_secondary"
            android:textSize="14sp" />


        <!-- ================================= -->
        <!-- 07 - CHIPGROUP / CHIP             -->
        <!-- ================================= -->

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="28dp"

            android:text="7. ChipGroup y Chip"

            android:textColor="@color/garage_text_primary"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="4dp"
            android:layout_marginBottom="12dp"

            android:text="Presenta opciones compactas que pueden seleccionarse directamente. Un ChipGroup permite organizar y controlar su selección."

            android:textColor="@color/garage_text_secondary"
            android:textSize="14sp" />

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/chipGroupWeather"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            app:singleSelection="true"
            app:selectionRequired="true">

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDry"

                style="@style/Widget.MaterialComponents.Chip.Choice"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Pista seca"
                android:checkable="true"
                android:checked="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipDamp"

                style="@style/Widget.MaterialComponents.Chip.Choice"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Pista húmeda"
                android:checkable="true" />

            <com.google.android.material.chip.Chip
                android:id="@+id/chipWet"

                style="@style/Widget.MaterialComponents.Chip.Choice"

                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:text="Lluvia"
                android:checkable="true" />

        </com.google.android.material.chip.ChipGroup>


        <!-- ================================= -->
        <!-- RESUMEN DE CONFIGURACIÓN          -->
        <!-- ================================= -->

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="32dp"

            app:cardBackgroundColor="@color/garage_surface"
            app:cardCornerRadius="16dp"

            app:strokeColor="@color/garage_border"
            app:strokeWidth="1dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"

                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:text="CONFIGURACIÓN ACTUAL"

                    android:textColor="@color/accent_mercedes"
                    android:textSize="12sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textSelectionStatus"

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    android:layout_marginTop="8dp"

                    android:text="Selecciona una opción para comenzar."

                    android:textColor="@color/garage_text_primary"
                    android:textSize="14sp" />

            </LinearLayout>

        </com.google.android.material.card.MaterialCardView>


        <!-- BOTÓN PARA CONSULTAR SELECCIONES -->

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonShowConfiguration"

            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:layout_marginTop="16dp"
            android:layout_marginBottom="24dp"

            android:text="Consultar configuración"

            android:textColor="@color/f1_white"

            app:backgroundTint="@color/accent_mercedes"
            app:cornerRadius="12dp" />

    </LinearLayout>

</ScrollView>